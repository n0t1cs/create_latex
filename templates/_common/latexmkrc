# .latexmkrc — read by latexmk (build.sh and VS Code LaTeX Workshop)
$out_dir = 'build';

# \include{chapters/x} writes build/chapters/x.aux: mirror the folder tree into build/
use File::Find ();
use File::Path ();
File::Find::find({ no_chdir => 1, wanted => sub {
    return unless -d $_;
    return if $_ eq '.';
    if (m{^\./build(/|$)} || m{/\.[^/]+$}) { $File::Find::prune = 1; return; }
    File::Path::make_path("build/" . substr($_, 2));
}}, '.');

# glossaries / acronyms / symbol lists -> makeglossaries (works with the build/ folder)
add_cus_dep('glo', 'gls', 0, 'run_makeglossaries');
add_cus_dep('acn', 'acr', 0, 'run_makeglossaries');
add_cus_dep('slo', 'sls', 0, 'run_makeglossaries');
add_cus_dep('syg', 'syi', 0, 'run_makeglossaries');
sub run_makeglossaries {
    my ($base_name, $path) = fileparse($_[0]);
    my @args = ('-d', $path, $base_name);
    unshift @args, '-q' if $silent;
    return system('makeglossaries', @args);
}
push @generated_exts, qw(glo gls glg acn acr alg slo sls slg syg syi ist xdy);
